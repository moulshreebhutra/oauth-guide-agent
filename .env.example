# Server-side only. Never commit real values; set them in Vercel > Project > Settings > Environment Variables.
GEMINI_API_KEY=
# Optional: defaults to gemini-3.8-flash (listed as free-tier on Google's pricing page, 2026-10-20)
GEMINI_MODEL=
# Optional: lets the agent check Composio managed-auth availability
COMPOSIO_API_KEY=

# Signs share links (/s/<token>). Any random string of 16+ chars: openssl rand -hex 24
# Leave empty to turn share links off. Never commit the real value.
SHARE_SECRET=

# Optional: embedding model used to re-order retrieved passages by meaning (default gemini-embedding-001)
GEMINI_EMBED_MODEL=
